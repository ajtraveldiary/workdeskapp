# Copy to .env for local development. Everything is optional locally:
# with no DATABASE_URL a local database is created in ./.data,
# and with no GOOGLE_CLIENT_ID you are signed in as a local dev user with demo emails.

# Neon connection string (Dashboard > Connection details)
DATABASE_URL=

# Google Cloud OAuth client (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only this Google account may sign in
OWNER_EMAIL=
# Public URL of the app; locally the Vite dev server
APP_URL=http://localhost:5173

# Random secrets: generate each with  node -e "console.log(crypto.randomBytes(32).toString('base64'))"
SESSION_SECRET=
TOKEN_ENC_KEY=

APP_TIMEZONE=Asia/Kolkata
